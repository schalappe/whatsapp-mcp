.PHONY: check audit

# Format, vet, build, and tests: the same command runs locally and in CI.
check:
	@unformatted="$$(gofmt -l .)"; if [ -n "$$unformatted" ]; then echo "gofmt needed:"; echo "$$unformatted"; exit 1; fi
	go vet ./...
	go build ./...
	go test ./...

# govulncheck is a `tool` in go.mod, so Dependabot's gomod updates keep it current.
audit:
	go tool govulncheck ./...
